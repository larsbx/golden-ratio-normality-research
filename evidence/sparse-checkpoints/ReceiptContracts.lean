    Nat.dist (2^1 * occurrences 2 1 0 (0 + 1 - 1)) (0 + 1 - 1) =
      Nat.dist (2^1 * 0) (0 + 1 - 1) :=
  GoldenNormality.Receipts.discrepancy_0_0
